{
  "schema_version": 2,
  "harness_id": "consumer-readme",
  "objective": "Keep the consumer's required README present and non-empty on the current Linux host.",
  "requirements": [
    {
      "id": "readme-present",
      "statement": "The consumer repository has a non-empty README.md file.",
      "acceptance": [
        "/usr/bin/test -s README.md exits successfully in the read-only target workspace."
      ],
      "depends_on": [],
      "evidence_actions": [
        "check-readme"
      ]
    }
  ],
  "plan": {
    "root_workflow": "main",
    "workflows": {
      "workflows": [
        {
          "id": "main",
          "root": {
            "kind": "action",
            "action": "check-readme"
          }
        }
      ]
    }
  },
  "actions": [
    {
      "id": "check-readme",
      "command": {
        "argv": [
          "/usr/bin/test",
          "-s",
          "README.md"
        ],
        "cwd": ".",
        "toolchains": [
          {
            "id": "system-core",
            "provider": "system",
            "executables": [
              "/usr/bin/test"
            ]
          }
        ]
      },
      "timeout_seconds": 30
    }
  ],
  "bounds": {
    "max_epochs": 10,
    "max_elapsed_seconds": 3600,
    "max_blocked_requirements": 1,
    "max_concurrent_external_actions": 1
  }
}
