#!/usr/bin/env bash
set -euo pipefail
# The installer puts the library in the git dir every checkout shares; an
# older install left it in this checkout's own git dir.
COMMITHOOKS_DIR="$(git rev-parse --git-common-dir)"
[ -f "$COMMITHOOKS_DIR/lib/common.sh" ] || COMMITHOOKS_DIR="$(git rev-parse --git-dir)"
source "$COMMITHOOKS_DIR/lib/common.sh"
source "$COMMITHOOKS_DIR/lib/commit-msg.sh"

commithooks_validate_conventional_commit "$1"
commithooks_validate_subject_line "$1"
